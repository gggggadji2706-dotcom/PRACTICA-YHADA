<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Задание 2</title>
</head>
<body>
  <button onclick="getWeather()">Получить погоду</button>
  <script>
    async function getWeather(){
            try {
                const response = await fetch('https://wttr.in/Moscow?format=j1');
                const data = await response.json();
                
                console.log(data);
            } catch (error) {
                console.log('ЧЕРТ О НЕТ Кажется произошла ошибка.');
            }
        }

        getWeather();
  </script>
</body>
</html>
