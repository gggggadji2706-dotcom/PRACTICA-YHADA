<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>Promise: checkWeather</title>
  </head>
  <body>
    <h1>Проверка погоды</h1>
    <p id="result1"></p>
    <p id="result2"></p>

    <script>
      function checkWeather(temperature) {
        return new Promise((resolve, reject) => {
          setTimeout(() => {
            if (temperature > 0) {
              resolve('Тепло!');
            } else {
              reject(new Error('Холодно!'));
            }
          }, 1000);
        });
      }

      checkWeather(5)
        .then(result => {
          document.getElementById('result1').textContent = `Температура 5°C: \${result}`;
        })
        .catch(error => {
          document.getElementById('result1').textContent = `Температура 5°C: \${error.message}`;
        });

      checkWeather(-5)
        .then(result => {
          document.getElementById('result2').textContent = `Температура -5°C: \${result}`;
        })
        .catch(error => {
          document.getElementById('result2').textContent = `Температура -5°C: \${error.message}`;
        });
    </script>
  </body>
</html>
